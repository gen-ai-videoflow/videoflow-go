{
  "name": "6eek-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "6eek desktop with its bundled Go engine and media tools",
  "author": "6eek contributors",
  "main": "main.cjs",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.6eek.desktop",
    "productName": "6eek",
    "directories": {
      "output": "../dist/electron"
    },
    "files": [
      "main.cjs",
      "engine.cjs",
      "package.json",
      "validate-payload.cjs"
    ],
    "extraResources": [
      {
        "from": "payload/6eek",
        "to": "engine"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/engine/6eek",
        "Contents/Resources/engine/ffmpeg",
        "Contents/Resources/engine/ffprobe"
      ]
    },
    "linux": {
      "target": [
        "deb",
        "AppImage",
        "tar.gz"
      ],
      "category": "AudioVideo",
      "maintainer": "6eek contributors"
    },
    "beforePack": "./validate-payload.cjs",
    "artifactName": "6eek-${version}-${os}-${arch}.${ext}"
  },
  "homepage": "https://github.com/JienWeng/videoflow-go"
}
