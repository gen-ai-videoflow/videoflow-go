FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/cloud-worker ./cmd/cloud-worker
FROM alpine:3.23
RUN apk add --no-cache ca-certificates tzdata ffmpeg && adduser -D -u 10001 app
COPY --from=build /out/cloud-worker /usr/local/bin/cloud-worker
USER app
ENTRYPOINT ["cloud-worker"]
