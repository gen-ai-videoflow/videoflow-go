FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/cloud ./cmd/cloud && \
    CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/cloud-migrate ./cmd/cloud-migrate && \
    CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/cloud-admin ./cmd/cloud-admin && \
    CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/cloud-rewards ./cmd/cloud-rewards
FROM alpine:3.23
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10001 app
COPY --from=build /out/cloud /out/cloud-migrate /out/cloud-admin /out/cloud-rewards /usr/local/bin/
USER app
EXPOSE 8080
ENV PORT=8080
ENTRYPOINT ["cloud"]
