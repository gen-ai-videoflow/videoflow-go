# Development only. Production uses ECS Secrets Manager references.
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://videoflow:local-development-only@postgres:5432/videoflow?sslmode=disable
REDIS_URL=redis://redis:6379/0
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
S3_BUCKET_ORIGINALS=videoflow-local-originals
S3_BUCKET_PLAYBACK=videoflow-local-playback
SQS_QUEUE_URL=http://localstack:4566/000000000000/videoflow-local-generation
SQS_DLQ_URL=http://localstack:4566/000000000000/videoflow-local-generation-dlq
PUBLIC_ORIGIN=http://localhost:8080
CLOUD_DEV_MODE=true
# Leave unset: no simulated payment is a confirmed live payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
MEDIACONVERT_ROLE_ARN=
MEDIACONVERT_ENDPOINT=
BILLING_ENABLED=false
CREDITS_PER_SECOND=10
MAIL_FROM=
S3_BUCKET_UPLOADS=videoflow-local-uploads
ENCODING_QUEUE_URL=http://localstack:4566/000000000000/videoflow-local-encoding
PROVIDER_DAILY_BUDGET_MICROS=0
PROVIDER_MAX_COST_MICROS=0
OPENROUTER_API_KEY=
OPENROUTER_VIDEO_MODEL=
MEMBERSHIPS_ENABLED=false
CONNECT_ENABLED=false
SUPPORTED_PAYOUT_COUNTRIES=
REWARDS_ENABLED=false
REWARD_BPS=0
REWARD_MONTHLY_CAP_CENTS=0
# Production ALB private CIDR only; leave blank for direct localhost development.
TRUSTED_PROXY_CIDRS=
CASH_PAYOUTS_ENABLED=false
S3_BUCKET_ANALYTICS=videoflow-local-analytics

# Browser-visible S3 emulator endpoint used only for presigned upload/download URLs.
S3_PUBLIC_ENDPOINT=http://localhost:4566
OPENROUTER_STORY_MODEL=
STORY_CREDITS=0
STORY_MAX_COST_MICROS=0
ASSEMBLY_CREDITS=0
FFMPEG_PATH=ffmpeg
PREMIUM_PRICE_CENTS=0

# New checkout: CryptoRails only, disabled until tenant + wallet + fee policy approval.
# Server-side secrets only; never prefix these with VITE_ or expose them in RPC headers.
CRYPTORAILS_ENABLED=false
CRYPTORAILS_API_URL=https://api.cryptorails.tech/v1
CRYPTORAILS_API_KEY=
CRYPTORAILS_WEBHOOK_SECRET=
CRYPTORAILS_NETWORK=
CRYPTORAILS_VM_TYPE=
CRYPTORAILS_TOKEN=
CRYPTORAILS_TOKEN_DECIMALS=0
CRYPTORAILS_TOKEN_ADDRESS=
CRYPTORAILS_TREASURY_ADDRESS=
# Blank is unconfigured; explicit 0 requires an approved zero fixed fee.
CRYPTORAILS_DEPOSIT_FIXED=
CRYPTORAILS_DEPOSIT_FEE_BPS=0
CRYPTORAILS_USD_PEG_ACCEPTED=false
